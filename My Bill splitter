try:
    bill = float(input("Enter total bill amount: "))
    discount_percent = float(input("Enter discount % (0 if none): "))
    tip_percent = float(input("Enter Tip percentage: "))
    gst_percent = float(input("Enter GST % (0 if none): "))
    friends = int(input("How many people? "))

    if friends <= 0:
        print("Error: Friends are more than 1!")
    else:
        # Calculations
        discount_amount = bill * discount_percent / 100
        bill_after_discount = bill - discount_amount
        
        gst_amount = bill_after_discount * gst_percent / 100
        bill_after_gst = bill_after_discount + gst_amount
        
        tip_amount = bill_after_gst * tip_percent / 100
        total_bill = bill_after_gst + tip_amount
        
        per_person = total_bill / friends

